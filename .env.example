# ======== Core ========
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
# Public base URL of the API, used to build OAuth redirect URIs
API_PUBLIC_URL=http://localhost:4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/content_bt
# Leave empty to use the built-in in-process scheduler (no Redis needed)
REDIS_URL=redis://localhost:6379
# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
TOKEN_ENCRYPTION_KEY=change-me-64-hex-chars
# Where uploaded master videos are stored locally
MEDIA_STORAGE_DIR=../../storage/media
# Python video analyzer service
ANALYZER_URL=http://localhost:8001

# ======== Meta (Facebook + Instagram) ========
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# ======== Google (YouTube) ========
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ======== Optional AI narrative layer ========
# If set, insights get an LLM-written narrative constrained to the computed evidence.
# Without it, deterministic templates are used (all numbers are still computed the same way).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# The Claude director (Phase 3) uses the same key. Models and the budget per video are set in Studio settings.
# Web search must be allowed for the key's organisation in the Claude Console (Settings -> Privacy); without it Claude researches from what it knows.
# ANTHROPIC_WEB_SEARCH_TOOL=web_search_20250305

