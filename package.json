{
  "name": "content-intelligence-platform",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "migrate": "npm --workspace apps/api run migrate",
    "seed:admin": "npm --workspace apps/api run seed:admin",
    "seed:demo": "npm --workspace apps/api run seed:demo",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "build": "npm --workspace apps/api run build && npm --workspace apps/web run build",
    "test": "npm --workspace apps/api run test",
    "setup": "node scripts/setup.mjs",
    "dev": "npm run dev:web",
    "start": "npm --workspace apps/api run start",
    "typecheck": "npm --workspace apps/api exec tsc -- --noEmit -p . && npm --workspace apps/web exec tsc -- --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  }
}
